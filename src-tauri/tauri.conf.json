{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harness_mini",
  "version": "0.1.0",
  "identifier": "com.harness.mini",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5601",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "harness_mini",
        "width": 1440,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
